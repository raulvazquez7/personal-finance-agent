# Database (Supabase Postgres). Local stack: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# jev (TypeSafe AI) — https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# xAI grok — https://console.x.ai
XAI_API_KEY=
# Chat agent (slice 4). Defaults live in apps/api/finance/settings.py (ChatSettings);
# override any of them here, for example:
# CHAT__MODEL=xai:grok-4.7
# CHAT__REASONING_EFFORT=high          # low, medium, high, xhigh
# CHAT__SUMMARY_REASONING_EFFORT=medium
# CHAT__TITLE_MODEL=xai:grok-4.20-non-reasoning
# CHAT__MAX_SQL_CALLS_PER_TURN=8

# Langfuse tracing — https://cloud.langfuse.com (EU)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# API hosts the server answers (DNS-rebinding guard). Keep "testserver": TestClient sends
# Host: testserver, so without it every API test gets a 400.
# TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
